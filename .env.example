# Copy to .env.local (gitignored). `stripe projects env --pull` writes the real values.
# Nothing here may carry a VITE_ prefix — that would inline it into the client bundle.

# Reasoner — any ONE of these is enough. OpenRouter is what Stripe Projects provisions;
# `stripe projects env --pull` writes it as OPENROUTER_API_API_KEY and the code accepts
# either spelling.
OPENROUTER_API_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional tuning
# SWARM_PROVIDER=openrouter        # pin when more than one key is present
# SWARM_MODEL=anthropic/claude-opus-5   # skip catalogue lookup; must be routable by the key
# SWARM_EFFORT=high                # anthropic only: low | medium | high | xhigh | max
# SWARM_APP_URL=https://savesplat.vercel.app   # OpenRouter attribution header

# Optional run log — a Postgres connection string, server-side only. Stripe Projects
# writes SUPABASE_POOLER_URL (preferred for serverless) and SUPABASE_DB_URL.
# SUPABASE_POOLER_URL=          # arrives with [YOUR-PASSWORD]; env.ts fills it from SUPABASE_DB_PASS
# SUPABASE_DB_PASS=
# SUPABASE_DB_URL=
# DATABASE_URL=

# Optional incident reviewer — the Athena agent (athena/agents). Written by
# `stripe projects env --pull`; the agent is a headless MCP server.
# ATHENA_ATHENA_AGENT_API_KEY=
# ATHENA_ATHENA_AGENT_MCP_URL=
# ATHENA_ATHENA_AGENT_PUBLIC_URL=
# ATHENA_ATHENA_AGENT_ID=
# ATHENA_ATHENA_API_BASE_URL=
